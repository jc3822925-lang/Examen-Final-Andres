{
  "expo": {
    "name": "FotoAuth",
    "slug": "foto-auth-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "fotoauth",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.umg.fotoauth",
      "infoPlist": {
        "NSCameraUsageDescription": "FotoAuth necesita acceso a la cámara para capturar fotografías.",
        "NSPhotoLibraryUsageDescription": "FotoAuth necesita acceso a la galería para seleccionar fotografías."
      }
    },
    "android": {
      "package": "com.umg.fotoauth",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FotoAuth necesita acceso a la galería para seleccionar fotografías.",
          "cameraPermission": "FotoAuth necesita acceso a la cámara para capturar fotografías."
        }
      ]
    ]
  }
}
